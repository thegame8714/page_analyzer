# Copy to .env.local (never commit .env.local).

# Random string, at least 32 characters, used to sign sign-in cookies.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Comma-separated emails allowed to sign in (case-insensitive).
ALLOWED_EMAILS=

# Only needed for the Top 3 competitors feature (currently disabled).
ANTHROPIC_API_KEY=
